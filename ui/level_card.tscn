[gd_scene load_steps=3 format=4]

[ext_resource type="Script" path="res://scripts/level_card.gd" id="1_card"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.07, 0.09, 0.11, 1.0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.18, 0.24, 0.30, 1.0)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[node name="LevelCard" type="PanelContainer"]
custom_minimum_size = Vector2(80, 90)
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="OdsNum" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "ODS"
theme_override_colors/font_color = Color(0.40, 0.92, 0.62, 1.0)
theme_override_font_sizes/font_size = 7

[node name="OdsName" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Nome"
autowrap_mode = 2
theme_override_colors/font_color = Color(0.96, 0.97, 0.98, 1.0)
theme_override_font_sizes/font_size = 6

[node name="Bioma" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Bioma"
autowrap_mode = 2
theme_override_colors/font_color = Color(0.62, 0.66, 0.72, 1.0)
theme_override_font_sizes/font_size = 6

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Status" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "—"
theme_override_font_sizes/font_size = 6

[node name="PlayButton" type="Button" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.40, 0.92, 0.62, 1.0)
theme_override_font_sizes/font_size = 7
flat = true
text = "jogar →"

[connection signal="mouse_entered" from="." to="." method="_on_mouse_entered"]
[connection signal="mouse_exited" from="." to="." method="_on_mouse_exited"]
